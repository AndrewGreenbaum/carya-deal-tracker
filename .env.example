# API Keys - Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional YC company directory access. Both values are required for Algolia requests.
YC_ALGOLIA_APP_ID=
YC_ALGOLIA_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://bud:tracker@localhost:5432/budtracker

# Optional: Webhook notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

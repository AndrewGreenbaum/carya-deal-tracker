# API Keys - Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional YC company directory access. Both values are required for Algolia requests.
YC_ALGOLIA_APP_ID=
YC_ALGOLIA_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://bud:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/budtracker

# Optional: Webhook notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Generate a random key (for example: python -c "import secrets; print(secrets.token_urlsafe(32))").
# Server only. Enter it at dashboard sign-in; never set VITE_API_KEY.
API_KEYS=
POSTGRES_PASSWORD=
